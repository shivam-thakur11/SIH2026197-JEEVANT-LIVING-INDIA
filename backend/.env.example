# ==============================================================================
# JEEVANT: LIVING INDIA — Backend Environment Configuration
# Problem Statement 26197 | Smart India Hackathon 2026
# Theme: Heritage & Culture
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/jeevant
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jeevant?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/jeevant

# JWT (JSON Web Token) Configuration
# Use a long, random secret key (minimum 64 characters in production)
JWT_SECRET=jeevant_super_secure_jwt_secret_sih2026_heritage_culture_portal
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# ==============================================================================
# OPTIONAL EXTERNAL CLOUD & AI INTEGRATIONS (ASSISTIVE ROADMAP)
# The application functions in graceful demo mode if these keys are absent.
# ==============================================================================

# Google Cloud Speech-to-Text (Artisan voice storytelling)
# GOOGLE_SPEECH_API_KEY=your_google_speech_key_here

# Google Cloud Translation (Vernacular multilingual support)
# GOOGLE_TRANSLATE_API_KEY=your_google_translate_key_here

# Google Gemini / LLM (Assistive cultural content structuring)
# GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision / Auto-Tagging
# GOOGLE_VISION_API_KEY=your_google_vision_key_here

# Cloud Storage for Artisan Media (GCS / Cloudinary)
# GCS_BUCKET_NAME=your_gcs_bucket_name
# GCS_PROJECT_ID=your_gcs_project_id
# CLOUDINARY_CLOUD_NAME=your_cloudinary_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret

# Google Maps API (Artisan Geographic Mapping)
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here
